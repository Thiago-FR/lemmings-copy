level_name = "Britadeira"
instructions = "Uma parede grossa separa os lemmings da SAIDA. Escolha a Britadeira e clique num lemming andando para a direita: ele guarda a ferramenta e, ao chegar na parede, cava um tunel reto ate o outro lado. Os outros lemmings passam pelo mesmo tunel."
