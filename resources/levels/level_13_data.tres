[resource]
script = ExtResource("1_script")
level_name = "Picareta"
instructions = "Um morro de terra separa os lemmings da SAIDA. Escolha a Picareta e clique num lemming andando para a direita: ele guarda a ferramenta e, ao chegar no morro, cava um tunel reto, da altura dele, ate o outro lado. Os outros lemmings passam pelo mesmo tunel."
