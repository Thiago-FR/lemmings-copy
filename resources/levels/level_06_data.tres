[resource]
script = ExtResource("1_script")
level_name = "Escada vertical"
instructions = "A SAIDA fica em cima da plataforma alta. Escolha a Escada vertical e clique num lemming: ele guarda a escada e, ao chegar na parede da plataforma, monta a escada encostada nela, um degrau por vez, e sobe. Depois disso, todo lemming que passar pela escada sobe sozinho."
