[resource]
script = ExtResource("1_script")
level_name = "Ponte"
instructions = "A SAIDA fica do outro lado do buraco, e quem cai nele nao volta. Escolha a Ponte e clique no primeiro lemming andando para a direita: ele vai ate a beira do buraco e monta uma ponte, uma peca por vez, ate o outro lado. Os outros lemmings atravessam pela mesma ponte."
