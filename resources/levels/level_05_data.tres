[resource]
script = ExtResource("1_script")
level_name = "Livre (todas as ferramentas)"
instructions = "Todas as ferramentas liberadas. A SAIDA (verde) fica do outro lado de um vao fatal - sem Escada diagonal ou Paraquedista o lemming cai e morre. Use a parede pra testar o Escalador e o piso grosso pra testar Pá, Perfurador e Minerador. Use a Escada vertical embaixo de um teto pra subir atraves dele."
