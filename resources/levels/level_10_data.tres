[ext_resource type="Script" path="res://scripts/level/level_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
level_name = "Escudo"
instructions = "A SAIDA fica a esquerda, mas os lemmings saem andando para a direita, direto para um buraco sem fundo. Escolha o Escudo e clique no primeiro lemming antes que ele chegue ao buraco: ele para ali e faz os outros darem meia-volta. Quem recebe o Escudo fica parado ate o tempo acabar."
