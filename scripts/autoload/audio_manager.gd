extends Node
## Plays music (one looping track at a time) and sound effects (pooled
## players so overlapping sounds don't cut each other off).
##
## Sounds are played by id: the file name of a WAV generated by
## tools/build_audio.py under assets/audio/sfx/ (or music/). Gameplay code
## only names the moment ("dig_earth", "explosion"); which file plays and how
## loud lives here. A missing file plays nothing, so a sound can be added to
## the code before it exists.
##
## Three volume channels, each its own audio bus: the overall volume
## (Master), music and effects. Set in the settings screen and saved to
## user://settings.cfg, so they come back the next time the game starts.
##
## The M key mutes and unmutes everything (also in the settings screen).

signal muted_changed(is_muted: bool)

enum Channel { MASTER, MUSIC, EFFECTS }

const BUS_NAMES := {
	Channel.MASTER: &"Master",
	Channel.MUSIC: &"Music",
	Channel.EFFECTS: &"Effects",
}
## Starting volumes, 0 to 1. Below full: the user found the first version
## too loud.
const DEFAULT_VOLUMES := {
	Channel.MASTER: 0.8,
	Channel.MUSIC: 0.5,
	Channel.EFFECTS: 0.8,
}
const SETTINGS_PATH := "user://settings.cfg"
const SETTINGS_SECTION := "audio"

const SFX_PLAYER_POOL_SIZE = 8
const SFX_PATH := "res://assets/audio/sfx/%s.wav"
const MUSIC_PATH := "res://assets/audio/music/%s.wav"
## Per-sound loudness, in dB. The generated sounds are all normalised to
## the same peak, but the square-wave blips sound much louder than the noisy
## ones at the same peak.
const SOUND_VOLUMES_DB := {
	&"assign_tool": -9.0,
	&"select_tool": -12.0,
	&"spawn": -10.0,
	&"saved": -8.0,
	&"level_won": -6.0,
	&"level_lost": -4.0,
	&"dig_earth": -4.0,
	&"pickaxe_hit": -4.0,
	&"jackhammer_hit": -5.0,
	&"place_brick": -4.0,
	&"place_ladder": -4.0,
	&"fuse": -6.0,
}
const MUSIC_VOLUME_DB := -12.0

var is_muted: bool = false

var _volumes: Dictionary = DEFAULT_VOLUMES.duplicate()

@onready var _music_player: AudioStreamPlayer = _create_player("MusicPlayer")

var _sfx_players: Array[AudioStreamPlayer] = []
var _next_sfx_player_index: int = 0
var _streams: Dictionary = {}
var _current_music: StringName = &""


func _ready() -> void:
	_create_buses()
	for i in range(SFX_PLAYER_POOL_SIZE):
		var player := _create_player("SfxPlayer%d" % i)
		player.bus = BUS_NAMES[Channel.EFFECTS]
		_sfx_players.append(player)
	_music_player.bus = BUS_NAMES[Channel.MUSIC]
	# Music keeps playing under the pause screen; effects pause with the game.
	_music_player.process_mode = Node.PROCESS_MODE_ALWAYS
	load_settings()


## Volume of a channel, from 0 (silent) to 1 (full).
func get_volume(channel: Channel) -> float:
	return _volumes[channel]


func set_volume(channel: Channel, volume: float) -> void:
	_volumes[channel] = clampf(volume, 0.0, 1.0)
	_apply_volume(channel)


func save_settings() -> void:
	var config := ConfigFile.new()
	config.load(SETTINGS_PATH)
	for channel in _volumes:
		config.set_value(SETTINGS_SECTION, String(BUS_NAMES[channel]).to_lower(), _volumes[channel])
	config.set_value(SETTINGS_SECTION, "muted", is_muted)
	config.save(SETTINGS_PATH)


func load_settings() -> void:
	var config := ConfigFile.new()
	config.load(SETTINGS_PATH)
	for channel in DEFAULT_VOLUMES:
		var key := String(BUS_NAMES[channel]).to_lower()
		set_volume(channel, config.get_value(SETTINGS_SECTION, key, DEFAULT_VOLUMES[channel]))
	if config.get_value(SETTINGS_SECTION, "muted", false) != is_muted:
		toggle_mute()


## Music and effects get buses of their own, routed into Master, so each can
## be turned down on its own. Made here rather than in a bus layout file so
## the setup lives with the code that uses it.
func _create_buses() -> void:
	for channel in [Channel.MUSIC, Channel.EFFECTS]:
		var bus_name: StringName = BUS_NAMES[channel]
		if AudioServer.get_bus_index(bus_name) != -1:
			continue
		AudioServer.add_bus()
		var index := AudioServer.bus_count - 1
		AudioServer.set_bus_name(index, bus_name)
		AudioServer.set_bus_send(index, BUS_NAMES[Channel.MASTER])


func _apply_volume(channel: Channel) -> void:
	var index := AudioServer.get_bus_index(BUS_NAMES[channel])
	if index != -1:
		AudioServer.set_bus_volume_db(index, linear_to_db(maxf(_volumes[channel], 0.0001)))


func _unhandled_key_input(event: InputEvent) -> void:
	var key := event as InputEventKey
	if key != null and key.pressed and not key.echo and key.keycode == KEY_M:
		toggle_mute()
		get_viewport().set_input_as_handled()


## Plays the sound effect with this id (see the class description).
func play_sound(sound_id: StringName) -> void:
	play_sfx(_load(SFX_PATH % sound_id), SOUND_VOLUMES_DB.get(sound_id, 0.0))


func play_sfx(stream: AudioStream, volume_db: float = 0.0) -> void:
	if stream == null:
		return
	var player := _sfx_players[_next_sfx_player_index]
	_next_sfx_player_index = (_next_sfx_player_index + 1) % _sfx_players.size()
	player.stream = stream
	player.volume_db = volume_db
	player.play()


## Starts the looping music track with this id, unless it is already on.
func play_music_track(track_id: StringName) -> void:
	if _current_music == track_id and _music_player.playing:
		return
	var stream := _load(MUSIC_PATH % track_id) as AudioStreamWAV
	if stream == null:
		return
	_current_music = track_id
	_make_looping(stream)
	play_music(stream, MUSIC_VOLUME_DB)


func play_music(stream: AudioStream, volume_db: float = 0.0) -> void:
	if _music_player.stream == stream and _music_player.playing:
		return
	_music_player.stream = stream
	_music_player.volume_db = volume_db
	_music_player.play()


func stop_music() -> void:
	_current_music = &""
	_music_player.stop()


func toggle_mute() -> void:
	is_muted = not is_muted
	AudioServer.set_bus_mute(AudioServer.get_bus_index(BUS_NAMES[Channel.MASTER]), is_muted)
	muted_changed.emit(is_muted)
	save_settings()


func _load(path: String) -> AudioStream:
	if not _streams.has(path):
		_streams[path] = load(path) if ResourceLoader.exists(path) else null
	return _streams[path]


## The generated tracks are written to loop seamlessly; this tells Godot to
## loop the whole file instead of relying on an import setting per track.
func _make_looping(stream: AudioStreamWAV) -> void:
	if stream.loop_mode != AudioStreamWAV.LOOP_DISABLED:
		return
	# From the length rather than the data size: the import may compress the
	# samples, and then bytes no longer map to samples.
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)


func _create_player(node_name: String) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.name = node_name
	add_child(player)
	return player
